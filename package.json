{
  "name": "ffmpeg-tool",
  "version": "1.0.0",
  "description": "Electron app to extract audio and frames using FFmpeg",
  "main": "main.js",
  "author": "Nandu",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "ffmpeg-tool",
    "productName": "FFmpeg Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "ffmpeg/**/*"
    ],
    "extraResources": [
      {
        "from": "ffmpeg/",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "artifactName": "FFmpeg-Tool-Setup.exe",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
